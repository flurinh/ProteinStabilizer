# Copy to .env.docker and adjust these paths for the host.
# Keep caches and temporary files on a large-volume filesystem.
HOST_UID=1000
HOST_GID=1000
VCS_REF=unknown
HF_CACHE_HOST=/data/fast/cache/huggingface
TORCH_CACHE_HOST=/data/fast/cache/torch
PROTEIN_STABILIZER_TMP_HOST=/data/fast/tmp/protein-stabilizer-docker
